  "schema": "inventory-aging/v1",
  "company": "Northwind Components",
  "currency": "USD",
  "period": "month",
  "conventions": {
    "bucketMix": "bucket / total inventory, where total is the sum of finite 0-30, 31-60, 61-90, and 90+ buckets",
    "pct90Plus": "90+ inventory / total inventory",
    "reserveCoverage": "obsolescenceReserve / 90+ inventory",
    "mom": "this month minus prior month",
    "vsTarget": "pct90Plus and writeOffs are ceilings (meeting when value <= target); mix030 and reserveCoverage are floors (meeting when value >= target)"
  },
  "targets": {
    "mix030": 0.5,
    "pct90Plus": 0.12,
    "reserveCoverage": 0.8,
    "writeOffs": 75000
  },
  "targetPolarity": {
    "mix030": "floor",
    "pct90Plus": "ceiling",
    "reserveCoverage": "floor",
    "writeOffs": "ceiling"
  },
